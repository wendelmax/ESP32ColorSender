{
  "name": "esp32-color-sender-electron",
  "version": "1.1.1",
  "description": "Aplicativo para enviar comandos de cor para ESP32 via Wi-Fi.",
  "repository": {
    "type": "git",
    "url": "https://github.com/wendelmax/ESP32ColorSender.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "keywords": [],
  "author": "Jackson Wendel <jackson@example.com>",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.wendelmax.esp32colorsender",
    "productName": "ESP32 Color Sender",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}